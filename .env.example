# Copy to .env next to server.py (or pass with `docker run --env-file .env`).
# Variables already set in the environment take precedence over this file.

# Video -> plan: roomplan-app API (GPU service deployed separately)
ROOMPLAN_VIDEO_API_URL=http://127.0.0.1:8802
ROOMPLAN_VIDEO_API_TOKEN=
# Optional JSON job options, e.g. for 24 GB GPUs:
# ROOMPLAN_VIDEO_API_OPTIONS={"beam_rec":{"target_frames":200,"frames_lo":150,"frames_hi":250}}

# Object from photo: local Stable Fast 3D adapter (loopback only)
# ROOMPLAN_RECONSTRUCTION_URL=http://127.0.0.1:8000/reconstruct
